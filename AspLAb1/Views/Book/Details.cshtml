@model Book?
@{
    ViewData["Title"] = Model?.Title ?? "Szczegóły książki";
}

<h2>Szczegóły książki nr @ViewBag.Id</h2>

@if (Model is not null)
{
    <dl class="row mt-3">
        <dt class="col-sm-3">Tytuł</dt>
        <dd class="col-sm-9">@Model.Title</dd>

        <dt class="col-sm-3">Autor</dt>
        <dd class="col-sm-9">@Model.Author</dd>

        <dt class="col-sm-3">Wydawnictwo</dt>
        <dd class="col-sm-9">@Model.Publisher</dd>

        <dt class="col-sm-3">ISBN</dt>
        <dd class="col-sm-9">@Model.Isbn</dd>

        <dt class="col-sm-3">Data wydania</dt>
        <dd class="col-sm-9">@Model.PublicationDate?.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-3">Liczba stron</dt>
        <dd class="col-sm-9">@Model.NumPages</dd>

        <dt class="col-sm-3">Cena</dt>
        <dd class="col-sm-9">@Model.Price.ToString("C")</dd>
    </dl>

    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edytuj</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Usuń</a>
}

<a asp-action="Index" class="btn btn-secondary">Powrót do listy</a>
